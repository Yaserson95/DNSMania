// Windows resource script: embeds the application icon and version info
// into the executable. Paths are relative to this file's directory (src/resources/).
IDI_APP_ICON ICON "../resources/dnsmania.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "DNS Mania"
            VALUE "FileDescription", "DNS Mania - Windows DNS Server Manager"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "DNSMania"
            VALUE "LegalCopyright", "Copyright (C) 2026 DNS Mania"
            VALUE "OriginalFilename", "DNSMania.exe"
            VALUE "ProductName", "DNS Mania"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
