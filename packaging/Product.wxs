<?xml version="1.0" encoding="utf-8"?>
<!--
  DNS Mania MSI package (WiX Toolset v3).
  Product version: 1.0.0. Files list is generated by make_installer.py
  (files.wxs, stable component GUIDs for clean upgrades).
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="DNS Mania"
           Language="1049"
           Codepage="1251"
           Version="1.0.0"
           Manufacturer="DNS Mania"
           UpgradeCode="{B7B70617-30AA-40A5-B48F-BB984240607B}">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="DNS Mania — управление зонами Windows DNS-сервера"
             Comments="Управление зонами Windows DNS-сервера" />

    <!-- Upgrade from any previous 1.x (including same-version rebuilds). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="Уже установлена более новая версия DNS Mania." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Icon in "Programs and Features" and in the Start menu shortcut. -->
    <Icon Id="DNSManiaIcon" SourceFile="..\resources\dnsmania.ico" />
    <Property Id="ARPPRODUCTICON" Value="DNSManiaIcon" />

    <!-- License dialog of the WixUI_Minimal flow. -->
    <Binary Id="WixUILicenseRtf" SourceFile="License.rtf" />
    <UIRef Id="WixUI_Minimal" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="DNS Mania" />
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Component Id="StartMenuShortcut" Guid="{10EE15E4-5C25-4320-8718-53A6844B3FF9}">
          <Shortcut Id="ApplicationShortcut"
                    Name="DNS Mania"
                    Description="Управление зонами Windows DNS-сервера"
                    Target="[INSTALLFOLDER]DNSMania.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="DNSManiaIcon" />
          <RemoveFolder Id="RemoveProgramMenu" Directory="ProgramMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\DNS Mania"
                         Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>

    <Feature Id="ProductFeature" Title="DNS Mania" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

  </Product>
</Wix>
